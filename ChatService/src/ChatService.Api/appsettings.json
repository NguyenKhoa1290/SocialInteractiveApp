{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ConnectionStrings": {
    "ChatDb": "",
    "Redis": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "identity-service",
    "Audience": "chat-app"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ChatLogTopic": "chat.service-log"
  },
  "Storage": {
    "HomeMaxBytes": 0,
    "MinPresignExpirySeconds": 300,
    "MaxPresignExpirySeconds": 21600,
    "AssumedThroughputBytesPerSec": 524288,
    "Providers": {
      "home": {
        "Endpoint": "http://192.168.50.10:9000",
        "AccessKey": "",
        "SecretKey": "",
        "BucketName": "chat-media",
        "ForcePathStyle": true
      },
      "cloud": {
        "Endpoint": "",
        "AccessKey": "",
        "SecretKey": "",
        "BucketName": "chat-media-large",
        "ForcePathStyle": true,
        "Region": "auto"
      }
    }
  },
  "WorkspaceClient": {
    "BaseUrl": "http://localhost:5153"
  },
  "MediaServiceClient": {
    "BaseUrl": "http://localhost:5300"
  },
  "IdentityClient": {
    "BaseUrl": "http://localhost:5194"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "",
    "StorageWarningQueue": "identity.storage-warning"
  },
  "StorageWarning": {
    "CheckIntervalMinutes": 60
  }
}
