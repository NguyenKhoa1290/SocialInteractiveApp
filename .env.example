# Chep file nay thanh ".env" (cung thu muc voi docker-compose.yml) roi dien
# gia tri that. File ".env" da duoc .gitignore bo qua - KHONG commit no.
#
#   cp .env.example .env
#   docker compose up -d media
#
# Khong tao .env thi moi thu van chay binh thuong voi LiveKit noi bo trong
# kind-livekit-cluster (gia tri mac dinh nam trong docker-compose.yml).

# ===== LiveKit Cloud =====
# Lay o dashboard cua project sau khi dang ky tai https://cloud.livekit.io
#
# HAI URL NAY KHAC NHAU VE SCHEME va deu tro toi cung mot ten mien:
#   - SERVER_URL dung https:// - Media Service goi Server API tu phia backend
#   - CLIENT_URL dung wss://   - tra ve cho trinh duyet tu ket noi WebRTC
# Dien nham scheme thi phong hop khong vao duoc ma log backend van sach.
LIVEKIT_SERVER_URL=https://<ten-project>.livekit.cloud
LIVEKIT_CLIENT_URL=wss://<ten-project>.livekit.cloud

# API key/secret sinh trong phan Settings > Keys cua project.
# SECRET thuong chi hien MOT LAN luc tao - luu lai ngay.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ===== Bi mat cua ban dev (docker-compose.yml) =====
# Truoc day nhung thang trong docker-compose.yml va appsettings.json - da
# tach ra de hai file do commit len GitHub cong khai duoc.
JWT_SIGNING_KEY=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
IDENTITY_DB_PASSWORD=
WORKSPACE_DB_PASSWORD=
CHAT_DB_PASSWORD=
SPAMTRACKING_DB_PASSWORD=
MEDIA_DB_PASSWORD=
MINIAPP_DB_PASSWORD=
